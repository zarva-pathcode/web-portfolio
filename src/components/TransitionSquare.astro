---
/**
 * Transition square (port from zamkara.dev)
 *
 * A 2160x2160px accent-coloured square that sweeps across the viewport on
 * client-side page transitions. Parked off-screen by default so it never
 * flashes on initial load.
 *
 * Driven by Astro's router lifecycle:
 *   - astro:before-preparation: sweeps into view to cover the viewport
 *   - astro:after-swap: holds for 250-350ms, then eases out and resets off-screen
 *
 * A transparent layer at z-index 10001 sits above it for transition micro-labels.
 * Strictly pointer-events: none throughout so it never blocks clicks.
 * Fully suppressed under prefers-reduced-motion: reduce.
 */
---

<div
  id="transition-square"
  class="pointer-events-none fixed top-1/2 right-full z-[9999] h-[2160px] w-[2160px] bg-accent will-change-transform"
  style="transform: translate3d(0, -50%, 0);"
  aria-hidden="true"
  transition:persist="transition-square"
></div>

<div
  id="transition-label-layer"
  class="pointer-events-none fixed inset-0 z-[10001] flex items-center justify-center select-none"
  aria-hidden="true"
  transition:persist="transition-label-layer"
>
  <span
    id="transition-label"
    class="font-mono text-xs font-semibold tracking-widest uppercase text-canvas opacity-0 transition-opacity duration-200"
  ></span>
</div>

<script>
  const REDUCED = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initTransitionSquare() {
    if ((window as any).__transitionSquareBound) return;
    (window as any).__transitionSquareBound = true;

    document.addEventListener('astro:before-preparation', (event: any) => {
      if (REDUCED()) return;

      const square = document.getElementById('transition-square');
      const label = document.getElementById('transition-label');
      if (!square) return;

      if (label && event.to) {
        try {
          const path = new URL(event.to, window.location.origin).pathname;
          const segment = path.replace(/^\/(id\/)?/, '').replace(/\/$/, '') || 'home';
          label.textContent = segment.replace(/[-/]/g, ' ');
          label.style.opacity = '1';
        } catch {
          // Fall back gracefully if URL parse fails
        }
      }

      const originalLoader = event.loader;
      event.loader = async () => {
        // Fast cubic ease into screen center
        square.style.transition = 'transform 240ms cubic-bezier(0.16, 1, 0.3, 1)';
        square.style.transform = 'translate3d(calc(50vw + 1080px), -50%, 0)';

        await Promise.all([
          originalLoader(),
          new Promise((resolve) => setTimeout(resolve, 200)),
        ]);
      };
    });

    document.addEventListener('astro:after-swap', () => {
      if (REDUCED()) return;

      const square = document.getElementById('transition-square');
      const label = document.getElementById('transition-label');
      if (!square) return;

      // Keep on screen for ~250-350ms, then sweep out
      setTimeout(() => {
        if (label) label.style.opacity = '0';
        square.style.transition = 'transform 280ms cubic-bezier(0.7, 0, 0.84, 0)';
        square.style.transform = 'translate3d(calc(100vw + 2200px), -50%, 0)';

        // Park back on the left off-screen without animation once cleared
        setTimeout(() => {
          square.style.transition = 'none';
          square.style.transform = 'translate3d(0, -50%, 0)';
        }, 300);
      }, 260);
    });
  }

  initTransitionSquare();
</script>
