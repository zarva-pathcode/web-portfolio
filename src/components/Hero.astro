---
import { Image } from 'astro:assets';
import { t, localePath, type Locale } from '../i18n';
import halftoneLight from '../assets/hero-halftone-light.png';
import halftoneDark from '../assets/hero-halftone-dark.png';
import { site, heroTicker, heroStats } from '../data/site';
import Ticker from './Ticker.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const isId = locale === 'id';
---

<section id="hero" class="relative flex min-h-svh flex-col bg-canvas text-ink">
  <div class="mx-auto flex w-full max-w-[1440px] flex-1 flex-col">
    <div class="relative flex min-w-0 flex-1 flex-col justify-between px-6 pt-8 pb-8 sm:px-10 sm:pt-12 lg:px-16">
      <!-- quiet editorial top meta strip (scrolls naturally, no sticky top navbar) -->
      <div
        data-hero-eyebrow
        class="mb-10 flex flex-wrap items-center justify-between gap-4 sm:mb-14"
      >
        <p class="label">
          <span class="text-brand">01</span> — <span data-scramble="view">{site.role.toUpperCase()}</span>
        </p>

        <div class="flex items-center gap-5">
          <span class="label inline-flex items-center gap-2 text-[0.5625rem] text-signal">
            <span class="size-1.5 rounded-full bg-signal" aria-hidden="true"></span>
            {site.availability[locale]}
          </span>
          <a
            href={localePath(locale, '/cv')}
            data-scramble="hover"
            class="label hidden text-[0.5625rem] text-ink transition-colors hover:text-brand sm:inline-block"
          >
            {isId ? 'CV ↗' : 'CV ↗'}
          </a>
        </div>
      </div>

      <div class="grid min-w-0 flex-1 items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(300px,42%)] lg:gap-6">
        <!-- copy -->
        <div class="relative z-10">
          <h1 class="display text-[2.75rem] sm:text-[4.25rem] lg:text-[5rem]" data-split>
            {tr['hero.headline']}
          </h1>

          <p
            data-hero-sub
            class="mt-7 max-w-[32rem] text-base leading-relaxed text-subtle sm:text-[1.0625rem]"
          >
            {tr['hero.sub']}
          </p>

          <div data-hero-cta class="mt-9 flex flex-wrap items-center gap-3">
            <a href="#projects" data-magnetic class="btn btn--solid btn-roll">
              <span class="btn-roll__track">
                <span class="btn-roll__text">{tr['hero.ctaPrimary']}</span>
                <span class="btn-roll__text btn-roll__text--clone" aria-hidden="true">
                  {tr['hero.ctaPrimary']}
                </span>
              </span>
            </a>
            <a href="#contact" data-magnetic class="btn btn--ghost btn-roll">
              <span class="btn-roll__track">
                <span class="btn-roll__text">{tr['hero.ctaSecondary']}</span>
                <span class="btn-roll__text btn-roll__text--clone" aria-hidden="true">
                  {tr['hero.ctaSecondary']}
                </span>
              </span>
            </a>
          </div>

          <dl data-hero-stats class="mt-12 flex flex-wrap items-end gap-12">
            {
              heroStats.map((stat) => (
                <div>
                  <dd
                    class="display text-[3rem] leading-none"
                    data-odometer={stat.value}
                  >
                    {stat.value}
                  </dd>
                  <dt class="label mt-2">{stat.label[locale]}</dt>
                </div>
              ))
            }
          </dl>
        </div>

        <!-- halftone portrait: one per ground, crossfaded on theme switch -->
        <div class="relative">
          <div
            class="relative mx-auto aspect-[1140/780] w-full max-w-[640px] lg:mr-0"
            data-portrait
            data-reveal="screen"
          >
            <Image
              src={halftoneLight}
              alt={`Portrait of ${site.name}, rendered as a clay halftone`}
              widths={[600, 900, 1140]}
              sizes="(min-width: 1024px) 40vw, 90vw"
              loading="eager"
              fetchpriority="high"
              class="halftone halftone--light absolute inset-0 h-full w-full object-contain"
            />
            <Image
              src={halftoneDark}
              alt=""
              aria-hidden="true"
              widths={[600, 900, 1140]}
              sizes="(min-width: 1024px) 40vw, 90vw"
              loading="eager"
              class="halftone halftone--dark absolute inset-0 h-full w-full object-contain"
            />
          </div>
          <p class="label mt-6 text-brand" data-scramble="view">Halftone / my-profile</p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6">
    <Ticker items={[...heroTicker]} speed={42} />
  </div>
</section>

<style>
  .halftone {
    transition: opacity 420ms var(--ease-enter);
  }
  :global(:root[data-theme='paper']) .halftone--dark,
  :global(:root:not([data-theme])) .halftone--dark {
    opacity: 0;
  }
  :global(:root[data-theme='night']) .halftone--light {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .halftone {
      transition: none;
    }
  }
</style>
