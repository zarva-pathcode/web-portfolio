---
import { getImage } from 'astro:assets';
import { localePath, type Locale } from '../i18n';
import heroPhoto from '../assets/bg-image-cutout.png';
import { getDefaultSection } from '../lib/cms/defaults';
import type { HeroSectionData, SettingsSectionData } from '../lib/cms/validators';
import Ticker from './Ticker.astro';

interface Props {
  locale: Locale;
  hero?: HeroSectionData;
  settings?: SettingsSectionData;
}
const {
  locale,
  hero = getDefaultSection('hero'),
  settings = getDefaultSection('settings'),
} = Astro.props;
const isId = locale === 'id';

const portraitSrc = hero.portraitUrl
  ? hero.portraitUrl
  : (
      await getImage({
        src: heroPhoto,
        format: 'webp',
        width: 1400,
        quality: 90,
      })
    ).src;
---

<section
  id="hero"
  data-cms-section="hero"
  class="relative flex min-h-svh flex-col overflow-x-clip bg-canvas text-ink"
>
  <div data-hero-stage class="relative flex w-full flex-1 flex-col">
    <!-- HeyNesh-inspired first-load kinetic wordmark opening (zero-FOUC via html.js, auto-skipped on revisit/scroll/reduced-motion) -->
    <div
      data-hero-opening
      aria-hidden="true"
      class="hero-opening pointer-events-none fixed inset-0 z-[85] flex-col items-center justify-center overflow-hidden bg-canvas px-6 text-ink"
    >
      <div class="w-full max-w-[1360px] overflow-hidden py-4">
        <p
          data-opening-wordmark
          class="display flex justify-center whitespace-nowrap text-[17vw] leading-[0.88] tracking-[-0.04em] text-ink sm:text-[15.5vw] lg:text-[14vw]"
        >
          {
            settings.brand.split('').map((ch, idx) => (
              <span
                data-opening-char
                class:list={['inline-block', idx === 0 && 'text-brand']}
              >
                {ch}
              </span>
            ))
          }
        </p>
      </div>
      <div class="mt-6 h-px w-48 overflow-hidden bg-[color:var(--hairline)] sm:w-72">
        <div data-opening-line class="h-full w-full origin-left bg-brand"></div>
      </div>
      <p
        data-opening-meta
        class="label mt-4 text-center text-[0.625rem] tracking-[0.22em] text-subtle"
      >
        {settings.role.toUpperCase()} · {settings.shortLocation.toUpperCase()}
      </p>
    </div>

    <!-- Quiet lower-left desktop watermark echoing ShellFooter -->
    <div
      data-hero-watermark
      aria-hidden="true"
      class="hero-watermark pointer-events-none absolute inset-x-0 bottom-0 z-[1] mx-auto hidden w-full max-w-[1440px] select-none overflow-hidden px-10 lg:block xl:px-16"
    >
      <p
        data-hero-watermark-text
        class="display translate-y-[18%] text-[12vw] leading-[0.75] tracking-[-0.04em] text-ink"
      >
        {settings.brand}
      </p>
    </div>

    <div class="mx-auto flex w-full max-w-[1440px] min-w-0 flex-1 flex-col justify-between px-5 pt-5 pb-3 sm:px-10 sm:pt-10 sm:pb-4 lg:px-16 lg:pt-12 lg:pb-0">
      <!-- Quiet editorial top meta strip -->
      <div
        data-hero-eyebrow
        data-hero-managed
        class="relative z-10 mb-4 flex flex-wrap items-center justify-between gap-3 sm:mb-8 lg:mb-10"
      >
        <p class="label">
          <span class="text-brand">01</span> · <span data-scramble="view">{hero.eyebrowRole.toUpperCase()}</span>
        </p>

        <div class="flex items-center gap-5">
          <span class="label inline-flex items-center gap-2 text-[0.5625rem] text-signal">
            <span class="size-1.5 rounded-full bg-signal" aria-hidden="true"></span>
            {hero.availability[locale]}
          </span>
          <a
            href={localePath(locale, '/cv')}
            data-scramble="hover"
            class="label hidden text-[0.5625rem] text-ink transition-colors hover:text-brand sm:inline-block"
          >
            CV ↗
          </a>
        </div>
      </div>

      <!-- Single responsive canvas stage -->
      <div
        data-hero-canvas-wrap
        class="relative -mx-5 mb-5 aspect-[16/10] w-[calc(100%+2.5rem)] overflow-hidden sm:-mx-10 sm:w-[calc(100%+5rem)] lg:pointer-events-none lg:absolute lg:inset-0 lg:z-0 lg:mx-0 lg:mb-0 lg:aspect-auto lg:h-full lg:w-full"
      >
        <canvas
          data-hero-canvas
          data-hero-src={portraitSrc}
          class="block h-full w-full"
          aria-hidden="true"
        ></canvas>
        <img
          data-hero-source
          src={portraitSrc}
          alt={`Portrait of ${settings.name}`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="sr-only"
        />
        <noscript>
          <img
            src={portraitSrc}
            alt={`Portrait of ${settings.name}`}
            class="h-full w-full object-cover object-top"
          />
        </noscript>
      </div>

      <!-- Whisper-quiet desktop-only optical spotlight cue -->
      <span
        data-hero-lens-hint
        aria-hidden="true"
        class="hero-lens-hint pointer-events-none absolute right-10 top-24 z-10 hidden items-center gap-2 border border-[color:var(--hairline)] bg-[color:var(--scrim)] px-2.5 py-1 label text-[0.5625rem] text-brand lg:inline-flex xl:right-16"
      >
        <span class="size-1.5 rounded-full bg-brand"></span>
        {isId ? 'ARAHKAN KURSOR' : 'HOVER LENS'}
      </span>

      <!-- Foreground editorial copy -->
      <div
        data-hero-copy
        class="relative z-10 my-auto max-w-[34rem] lg:max-w-[49%] lg:py-6"
      >
        <h1
          class="display text-[2.35rem] leading-[1.02] sm:text-[3.75rem] lg:text-[4.85rem]"
          data-split
          data-hero-managed
        >
          {hero.headline[locale]} <span class="text-brand">{hero.headlineAccent[locale]}</span>
        </h1>

        <p
          data-hero-sub
          data-hero-managed
          class="mt-4 max-w-[30rem] text-[0.9375rem] leading-relaxed text-subtle sm:mt-6 sm:text-[1.0625rem]"
        >
          {hero.sub[locale]}
        </p>

        <div data-hero-cta data-hero-managed class="mt-6 flex flex-wrap items-center gap-3 sm:mt-8">
          <a href="#projects" data-magnetic class="btn btn--solid btn-roll">
            <span class="btn-roll__track">
              <span class="btn-roll__text">{hero.ctaPrimary[locale]}</span>
              <span class="btn-roll__text btn-roll__text--clone" aria-hidden="true">
                {hero.ctaPrimary[locale]}
              </span>
            </span>
          </a>
          <a href="#contact" data-magnetic class="btn btn--ghost btn-roll">
            <span class="btn-roll__track">
              <span class="btn-roll__text">{hero.ctaSecondary[locale]}</span>
              <span class="btn-roll__text btn-roll__text--clone" aria-hidden="true">
                {hero.ctaSecondary[locale]}
              </span>
            </span>
          </a>
        </div>

        <dl
          data-hero-stats
          data-hero-managed
          class="mt-8 flex flex-wrap items-end gap-10 sm:mt-11 sm:gap-12"
        >
          {
            hero.stats.map((stat) => (
              <div>
                <dd
                  class="display text-[2.65rem] leading-none sm:text-[3rem]"
                  data-odometer={stat.value}
                  data-hero-managed
                >
                  {stat.value}
                </dd>
                <dt class="label mt-2">{stat.label[locale]}</dt>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>

  <div class="relative z-10 mt-auto">
    <Ticker items={[...hero.ticker]} speed={42} />
  </div>
</section>

<style>
  .hero-opening {
    display: none;
    will-change: clip-path, opacity;
  }

  /* Frame-0 zero-FOUC cover on fresh load & reload when JS is active and not an intra-app revisit */
  :global(html.js:not(.hero-opening-skip)) .hero-opening {
    display: flex;
  }

  :global(html.js:not(.hero-opening-skip)) .hero-opening [data-opening-char],
  :global(html.js:not(.hero-opening-skip)) .hero-opening [data-opening-meta] {
    opacity: 0;
  }

  :global(html.js:not(.hero-opening-skip)) .hero-opening [data-opening-line] {
    transform: scaleX(0);
  }

  .hero-watermark {
    opacity: 0.055;
  }

  :global(:root[data-theme='night']) .hero-watermark {
    opacity: 0.05;
    mix-blend-mode: soft-light;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-opening {
      display: none !important;
    }
  }

  .hero-lens-hint {
    transition: opacity 360ms var(--ease-hover);
  }

  .hero-lens-hint[data-dismissed='true'] {
    opacity: 0;
  }

  @media (hover: none), (pointer: coarse) {
    .hero-lens-hint {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-lens-hint {
      display: none !important;
    }
  }
</style>
