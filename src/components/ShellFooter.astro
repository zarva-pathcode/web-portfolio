---
import { getDefaultSection } from '../lib/cms/defaults';
import type { SettingsSectionData } from '../lib/cms/validators';
import { localePath, type Locale } from '../i18n';
import Ticker from './Ticker.astro';

interface Props {
  locale: Locale;
  settings?: SettingsSectionData;
}
const { locale, settings = getDefaultSection('settings') } = Astro.props;
const isId = locale === 'id';
const homeBase = localePath(locale, '/');

const mottoTicker = settings.footer.tickerMotto[locale];
---

<footer
  id="contact"
  data-cms-section="settings"
  class="relative overflow-hidden border-t border-[color:var(--hairline)] bg-canvas text-ink"
>
  <div
    data-footer-ambient
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[36vh] min-h-[220px] max-h-[340px]"
  >
    <canvas data-footer-fire class="footer-fire-canvas block h-full w-full" />
  </div>

  <div class="relative z-10">
    <Ticker items={[mottoTicker, mottoTicker, mottoTicker]} speed={58} />
  </div>

  <div class="relative z-10 mx-auto max-w-[1440px] px-5 pt-16 sm:px-10 lg:px-16">
    <div class="grid gap-12 py-16 md:grid-cols-[1.5fr_1fr]">
      <div>
        <p class="label mb-6" data-scramble="view">{isId ? 'Kontak' : 'Contact'}</p>

        <button
          type="button"
          data-copy-email={settings.email}
          class="group block text-left"
          aria-label={isId ? `Salin email ${settings.email}` : `Copy email ${settings.email}`}
        >
          <span class="display block text-[1.9rem] leading-tight text-brand-ink underline decoration-1 underline-offset-8 transition-colors group-hover:text-brand sm:text-[2.75rem]">
            {settings.email}
          </span>
          <span class="mt-4 inline-flex items-center gap-3">
            <span
              data-copy-status
              data-copied-label={isId ? 'TERSALIN ✓' : 'COPIED ✓'}
              aria-live="polite"
              class="copy-pill label text-[0.5625rem]"
            >
              {isId ? 'KLIK UNTUK SALIN' : 'CLICK TO COPY'}
            </span>
            <span class="label">
              {settings.footer.replyNote[locale]}
            </span>
          </span>
        </button>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${settings.email}`} data-magnetic class="btn btn--solid btn-roll">
            <span class="btn-roll__track">
              <span class="btn-roll__text">{isId ? 'KIRIM EMAIL' : 'SEND EMAIL'}</span>
              <span class="btn-roll__text btn-roll__text--clone" aria-hidden="true">
                {isId ? 'KIRIM EMAIL' : 'SEND EMAIL'}
              </span>
            </span>
          </a>
          <a href={localePath(locale, '/cv')} data-magnetic class="btn btn--ghost btn-roll">
            <span class="btn-roll__track">
              <span class="btn-roll__text">{isId ? 'LIHAT CV' : 'VIEW CV'}</span>
              <span class="btn-roll__text btn-roll__text--clone" aria-hidden="true">
                {isId ? 'LIHAT CV' : 'VIEW CV'}
              </span>
            </span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8">
        <div>
          <p class="label mb-4">{isId ? 'TAUTAN' : 'ELSEWHERE'}</p>
          <ul class="space-y-2">
            {
              settings.social.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="me noopener noreferrer"
                    data-scramble="hover"
                    class="label text-[0.625rem] normal-case tracking-normal text-ink transition-colors hover:text-brand-ink"
                  >
                    {s.handle}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="label mb-4">{isId ? 'HALAMAN' : 'PAGES'}</p>
          <ul class="space-y-2">
            <li>
              <a
                href={`${homeBase === '/' ? '' : homeBase}/#projects`}
                data-scramble="hover"
                class="label text-[0.625rem] normal-case tracking-normal text-ink hover:text-brand-ink"
              >
                {isId ? 'Karya' : 'Work'}
              </a>
            </li>
            <li>
              <a
                href={`${homeBase === '/' ? '' : homeBase}/#experience`}
                data-scramble="hover"
                class="label text-[0.625rem] normal-case tracking-normal text-ink hover:text-brand-ink"
              >
                {isId ? 'Pengalaman' : 'Experience'}
              </a>
            </li>
            <li>
              <a
                href={localePath(locale, '/blog')}
                data-scramble="hover"
                class="label text-[0.625rem] normal-case tracking-normal text-ink hover:text-brand-ink"
              >
                {isId ? 'Tulisan' : 'Writing'}
              </a>
            </li>
            <li>
              <a
                href={localePath(locale, '/cv')}
                data-scramble="hover"
                class="label text-[0.625rem] normal-case tracking-normal text-ink hover:text-brand-ink"
              >
                CV
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <p class="display max-w-[22rem] pb-10 text-[1.5rem] leading-[1.15] text-subtle">
      {settings.footer.motto[locale]}
    </p>
  </div>

  <div aria-hidden="true" class="relative z-10 select-none overflow-hidden">
    <p class="display mx-auto max-w-[1440px] translate-y-[18%] px-5 text-[19vw] leading-[0.75] tracking-[-0.04em] text-[color:color-mix(in_oklab,var(--ink)_9%,var(--canvas))] sm:px-10 lg:px-16">
      {settings.brand}
    </p>
  </div>
</footer>

<style>
  .footer-fire-canvas {
    display: block;
  }
</style>
