---
import { site, social } from '../data/site';
import { localePath, type Locale } from '../i18n';
import Ticker from './Ticker.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isId = locale === 'id';
const homeBase = localePath(locale, '/');

const motto = isId ? 'Ubah kekacauan jadi ketertiban' : 'Turn chaos into order';
const bars = [42, 62, 78, 54, 88, 70, 46, 82, 58];
---

<footer id="contact" class="relative overflow-hidden border-t border-[color:var(--hairline)] bg-canvas text-ink">
  <!-- spectrum: zamkara-style blurred bars rising from the floor -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-[46vh] overflow-hidden">
    <div class="absolute inset-0 grid grid-cols-9 items-end">
      {
        bars.map((h, i) => (
          <span
            class="spectrum-bar origin-bottom"
            style={`height:${h}%;animation-delay:${(i * 0.45).toFixed(2)}s`}
          />
        ))
      }
    </div>
  </div>

  <div class="relative z-10">
    <Ticker items={[motto, motto, motto]} speed={58} />
  </div>

  <div class="relative z-10 mx-auto max-w-[1440px] px-5 pt-16 sm:px-10 lg:px-16">
    <!-- contact block -->
    <div class="grid gap-12 py-16 md:grid-cols-[1.5fr_1fr]">
      <div>
        <p class="label mb-6" data-scramble="view">{isId ? 'Kontak' : 'Contact'}</p>

        <button
          type="button"
          data-copy-email={site.email}
          class="group block text-left"
          aria-label={isId ? `Salin email ${site.email}` : `Copy email ${site.email}`}
        >
          <span class="display block text-[1.9rem] leading-tight text-brand-ink underline decoration-1 underline-offset-8 transition-colors group-hover:text-brand sm:text-[2.75rem]">
            {site.email}
          </span>
          <span class="mt-4 inline-flex items-center gap-3">
            <span
              data-copy-status
              data-copied-label={isId ? 'TERSALIN ✓' : 'COPIED ✓'}
              aria-live="polite"
              class="copy-pill label text-[0.5625rem]"
            >
              {isId ? 'KLIK UNTUK SALIN' : 'CLICK TO COPY'}
            </span>
            <span class="label">
              {isId ? 'DIBALAS DALAM 24 JAM · WIB (GMT+7)' : 'REPLIES WITHIN 24 HOURS · WIB (GMT+7)'}
            </span>
          </span>
        </button>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${site.email}`} data-magnetic class="btn btn--solid btn-roll">
            <span class="btn-roll__track">
              <span class="btn-roll__text">{isId ? 'KIRIM EMAIL' : 'SEND EMAIL'}</span>
              <span class="btn-roll__text btn-roll__text--clone" aria-hidden="true">
                {isId ? 'KIRIM EMAIL' : 'SEND EMAIL'}
              </span>
            </span>
          </a>
          <a href={localePath(locale, '/cv')} data-magnetic class="btn btn--ghost btn-roll">
            <span class="btn-roll__track">
              <span class="btn-roll__text">{isId ? 'LIHAT CV' : 'VIEW CV'}</span>
              <span class="btn-roll__text btn-roll__text--clone" aria-hidden="true">
                {isId ? 'LIHAT CV' : 'VIEW CV'}
              </span>
            </span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8">
        <div>
          <p class="label mb-4">{isId ? 'TAUTAN' : 'ELSEWHERE'}</p>
          <ul class="space-y-2">
            {
              social.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="me noopener noreferrer"
                    data-scramble="hover"
                    class="label text-[0.625rem] normal-case tracking-normal text-ink transition-colors hover:text-brand-ink"
                  >
                    {s.handle}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="label mb-4">{isId ? 'HALAMAN' : 'PAGES'}</p>
          <ul class="space-y-2">
            <li>
              <a
                href={`${homeBase === '/' ? '' : homeBase}/#projects`}
                data-scramble="hover"
                class="label text-[0.625rem] normal-case tracking-normal text-ink hover:text-brand-ink"
              >
                {isId ? 'Karya' : 'Work'}
              </a>
            </li>
            <li>
              <a
                href={`${homeBase === '/' ? '' : homeBase}/#experience`}
                data-scramble="hover"
                class="label text-[0.625rem] normal-case tracking-normal text-ink hover:text-brand-ink"
              >
                {isId ? 'Pengalaman' : 'Experience'}
              </a>
            </li>
            <li>
              <a
                href={localePath(locale, '/blog')}
                data-scramble="hover"
                class="label text-[0.625rem] normal-case tracking-normal text-ink hover:text-brand-ink"
              >
                {isId ? 'Tulisan' : 'Writing'}
              </a>
            </li>
            <li>
              <a
                href={localePath(locale, '/cv')}
                data-scramble="hover"
                class="label text-[0.625rem] normal-case tracking-normal text-ink hover:text-brand-ink"
              >
                CV
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- motto -->
    <p class="display max-w-[22rem] pb-10 text-[1.5rem] leading-[1.15] text-subtle">
      {isId ? 'Jadilah gelap dalam terang, terang dalam kegelapan.' : 'Be dark in the light, be light in the dark.'}
    </p>
  </div>

  <!-- oversized wordmark, cropped by the floor -->
  <div aria-hidden="true" class="relative z-10 select-none overflow-hidden">
    <p class="display mx-auto max-w-[1440px] translate-y-[18%] px-5 text-[19vw] leading-[0.75] tracking-[-0.04em] text-ink/10 sm:px-10 lg:px-16">
      {site.brand}
    </p>
  </div>
</footer>

<style>
  .spectrum-bar {
    display: block;
    width: 100%;
    background: linear-gradient(
      to top,
      var(--brand) 0%,
      color-mix(in oklab, var(--brand) 55%, transparent) 45%,
      transparent 100%
    );
    filter: blur(38px);
    opacity: 0.55;
    transform-origin: bottom;
    animation: spectrum 6.5s ease-in-out infinite alternate;
  }

  @keyframes spectrum {
    from {
      transform: scaleY(0.72);
      opacity: 0.35;
    }
    to {
      transform: scaleY(1.06);
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spectrum-bar {
      animation: none;
    }
  }
</style>
