---
import { site, nav, social } from '../data/site';
import { localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isId = locale === 'id';
const here = Astro.url.pathname;
const isHome = here === '/' || here === '/id' || here === '/id/';
const homeBase = localePath(locale, '/');

const drawerLinks = [
  ...nav.map((item) => ({
    label: isId ? item.labelId : item.label,
    href: item.href.startsWith('#')
      ? isHome
        ? item.href
        : `${homeBase === '/' ? '' : homeBase}/${item.href}`
      : localePath(locale, item.href),
  })),
  {
    label: isId ? 'Tulisan & Catatan' : 'Writing & Notes',
    href: localePath(locale, '/blog'),
  },
  {
    label: isId ? 'Kontak' : 'Contact',
    href: `${homeBase === '/' ? '' : homeBase}/#contact`,
  },
];
---

<div data-nav-menu>
  <!-- Mobile Floating Bottom Pill Dock (< 640px) — replaces top navbar on phone -->
  <div
    class="mobile-dock fixed bottom-5 left-1/2 z-[65] flex -translate-x-1/2 items-center gap-1 rounded-full border border-[color:var(--hairline)] bg-[color:var(--scrim)] px-2 py-1.5 backdrop-blur-md sm:hidden"
    role="navigation"
    aria-label={isId ? 'Navigasi cepat mobile' : 'Mobile quick navigation'}
  >
    <a
      href={homeBase}
      class="label flex h-9 items-center px-3.5 text-[0.625rem] tracking-[0.18em] text-ink"
    >
      {site.brand}
    </a>
    <span class="h-4 w-px bg-[color:var(--hairline)]" aria-hidden="true"></span>
    <button
      type="button"
      data-theme-toggle
      class="theme-btn flex size-9 items-center justify-center rounded-full text-ink transition-colors active:bg-[color:var(--hover)]"
      aria-label={isId ? 'Ganti tema warna' : 'Switch colour theme'}
      aria-pressed="false"
    >
      <span class="theme-icon text-sm leading-none" data-theme-icon aria-hidden="true">☾</span>
    </button>
    <span class="h-4 w-px bg-[color:var(--hairline)]" aria-hidden="true"></span>
    <button
      type="button"
      data-nav-open
      class="ham-btn flex h-9 items-center gap-2 rounded-full px-3.5 text-ink transition-colors active:bg-[color:var(--hover)]"
      aria-label={isId ? 'Buka menu' : 'Open menu'}
      aria-controls="site-menu"
      aria-expanded="false"
    >
      <span class="ham-lines" aria-hidden="true">
        <span class="ham-line ham-line--top"></span>
        <span class="ham-line ham-line--bot"></span>
      </span>
    </button>
  </div>

  <!-- Animated Editorial Spine Drawer (desktop wipes from Left Rail; mobile wipes from bottom) -->
  <div data-nav-shell hidden class="fixed inset-0 z-[75] sm:z-[60]">
    <div
      data-nav-scrim
      class="spine-scrim fixed inset-0 bg-[#14110f]/45 backdrop-blur-[2px]"
      aria-hidden="true"
    ></div>

    <div
      id="site-menu"
      data-nav-panel
      data-lenis-prevent
      role="dialog"
      aria-modal="true"
      aria-label={isId ? 'Menu navigasi' : 'Navigation menu'}
      class="spine-drawer fixed inset-x-0 bottom-0 top-16 flex flex-col rounded-t-2xl border-t border-[color:var(--hairline)] bg-canvas text-ink shadow-2xl sm:inset-y-0 sm:left-[60px] sm:right-auto sm:top-0 sm:w-[min(620px,calc(100vw-60px))] sm:rounded-none sm:border-r sm:border-t-0"
    >
      <!-- Drawer Header -->
      <div class="flex items-center justify-between border-b border-[color:var(--hairline)] px-6 py-5 sm:px-12 sm:py-7">
        <span class="label text-[0.625rem] tracking-[0.18em] text-brand">
          INDEX — {site.brand}
        </span>

        <div class="flex items-center gap-4">
          <span class="label hidden items-center gap-2 text-[0.5625rem] text-signal sm:inline-flex">
            <span class="size-1.5 rounded-full bg-signal" aria-hidden="true"></span>
            {site.availability[locale]}
          </span>
          <button
            type="button"
            data-nav-close
            class="label rounded-[2px] border border-[color:var(--hairline)] px-3 py-1.5 text-[0.5625rem] text-ink transition-colors hover:border-ink hover:bg-ink hover:text-canvas sm:hidden"
            aria-label={isId ? 'Tutup menu' : 'Close menu'}
          >
            {isId ? 'TUTUP ×' : 'CLOSE ×'}
          </button>
        </div>
      </div>

      <!-- Staggered Editorial Links -->
      <nav
        class="flex flex-1 flex-col justify-center overflow-y-auto px-6 py-4 sm:px-12"
        aria-label={isId ? 'Navigasi situs' : 'Site navigation'}
      >
        <ul class="divide-y divide-[color:var(--hairline)] border-y border-[color:var(--hairline)]">
          {
            drawerLinks.map((item, i) => (
              <li>
                <a
                  href={item.href}
                  data-nav-link
                  class="group flex items-baseline gap-5 py-3.5 transition-colors hover:bg-[color:var(--hover)] sm:gap-7 sm:px-3 sm:py-4"
                >
                  <span class="label w-6 shrink-0 text-subtle transition-colors group-hover:text-brand">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="drawer-link-mask flex-1 transition-transform duration-300 group-hover:translate-x-1.5">
                    <span
                      data-drawer-link-inner
                      class="display block text-[1.95rem] leading-[1.08] text-ink transition-colors duration-200 group-hover:text-brand sm:text-[2.65rem]"
                    >
                      {item.label}
                    </span>
                  </span>
                  <span
                    class="label text-brand opacity-0 transition-all duration-300 group-hover:translate-x-0.5 group-hover:opacity-100"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Drawer Footer: Copy Email + Social -->
      <div
        data-drawer-footer
        class="flex flex-wrap items-center justify-between gap-4 border-t border-[color:var(--hairline)] px-6 py-5 sm:px-12 sm:py-6"
      >
        <button
          type="button"
          data-copy-email={site.email}
          class="inline-flex items-center gap-2.5 text-left"
        >
          <span class="label text-[0.625rem] normal-case tracking-normal text-brand-ink">
            {site.email}
          </span>
          <span
            data-copy-status
            data-copied-label={isId ? 'TERSALIN ✓' : 'COPIED ✓'}
            class="copy-pill label text-[0.5rem]"
          >
            {isId ? 'SALIN' : 'COPY'}
          </span>
        </button>

        <ul class="flex flex-wrap gap-x-4 gap-y-1.5">
          {
            social.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="me noopener noreferrer"
                  data-scramble="hover"
                  class="label text-[0.5625rem] hover:text-brand-ink"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</div>
