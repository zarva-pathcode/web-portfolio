---
import { disciplines } from '../data/site';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);

const icons: Record<string, string> = {
  Mobile:
    'M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3',
  Systems:
    'M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42',
  Engineering:
    'M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5',
};
---

<section id="what-i-do" class="canvas border-t border-white/10 py-24 md:py-36">
  <div
    class="mb-16 flex flex-col justify-between md:mb-24 md:flex-row md:items-end"
  >
    <div>
      <span class="eyebrow">{tr['disciplines.eyebrow']}</span>
      <h3 class="mt-3 text-3xl font-semibold tracking-tighter text-ink sm:text-5xl">
        {tr['disciplines.title']}
      </h3>
    </div>
    <p class="mt-4 max-w-md text-base leading-relaxed text-subtle md:mt-0 md:text-lg">
      {tr['disciplines.lede']}
    </p>
  </div>

    <div class="reveal-group grid grid-cols-1 divide-y divide-white/10 border-y border-white/10 md:grid-cols-3 md:divide-x md:divide-y-0">
    {
      disciplines.map((d, i) => (
        <div
          class:list={[
            'flex flex-col justify-between py-10 md:py-12 md:px-10 lg:px-12',
            i === 0 && 'md:pr-10 lg:pr-12',
            i === disciplines.length - 1 && 'md:pl-10 lg:pl-12',
          ]}
        >
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs tracking-widest text-accent uppercase">
                {d.index} / <span class="text-muted">{d.slug}</span>
              </span>
              <div class="grid size-8 place-items-center rounded-full border border-white/10 text-ink/70">
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={icons[d.slug]} />
                </svg>
              </div>
            </div>

            <h4 class="text-2xl font-semibold tracking-tight text-ink">{d.title}</h4>
            <p class="text-sm leading-relaxed text-subtle">{d.body}</p>
          </div>

          <div class="mt-10 flex flex-wrap gap-2 border-t border-white/6 pt-6">
            {d.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
