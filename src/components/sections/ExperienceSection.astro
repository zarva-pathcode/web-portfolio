---
import { listExperiences, type ExperienceRecord } from '../../lib/cms/repository';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
  experiences?: ExperienceRecord[];
}
const { locale, experiences } = Astro.props;
const isId = locale === 'id';

const entries = experiences ?? (await listExperiences());
const labels = {
  exp: isId ? 'PENGALAMAN' : 'EXPERIENCE',
  title: isId ? 'Pengalaman kerja.' : 'Work experience.',
};
---

<section
  id="experience"
  data-cms-section="experiences"
  class="border-t border-[color:var(--hairline)] bg-canvas text-ink"
>
  <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-10 lg:px-16 lg:py-28">
    <div class="mb-16 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="label mb-8">
          <span class="text-brand">04</span> · <span data-scramble="view">{labels.exp}</span>
        </p>
        <h2 class="display text-[2.25rem] sm:text-[3.25rem]" data-reveal="press" data-split>
          {labels.title}
        </h2>
      </div>
      <p class="label">
        {isId ? `${entries.length} peran · klik kartu untuk sorotan` : `${entries.length} roles · click any role to inspect`}
      </p>
    </div>

    <div class="exp-timeline relative" data-exp-list>
      <div
        data-exp-spine
        aria-hidden="true"
        class="pointer-events-none absolute top-4 bottom-4 left-[0.75rem] w-px -translate-x-1/2 overflow-hidden bg-[color:var(--hairline)] sm:left-[8.75rem]"
      >
        <div class="exp-spine-solid h-full w-full bg-[color:var(--brand)]/30"></div>
        <div class="exp-spine-pulse" data-exp-pulse></div>
      </div>

      <ol class="space-y-6 sm:space-y-8">
        {
          entries.map((d, i) => {
            const yearLabel = d.period.split(/[—–-]/)[0].trim().split(' ').slice(-1)[0];
            const isCurrent = i === 0;
            const panelId = `exp-impact-${i}`;
            return (
              <li
                data-exp-item={i}
                class:list={[
                  'exp-item grid grid-cols-[1.5rem_1fr] items-start sm:grid-cols-[7.5rem_2.5rem_1fr]',
                  isCurrent && 'is-current',
                ]}
              >
                <div class="hidden pr-4 pt-6 text-right sm:block">
                  <span
                    data-exp-year
                    class:list={[
                      'exp-year numeral text-[1.35rem] leading-none',
                      isCurrent ? 'text-brand' : 'text-subtle',
                    ]}
                  >
                    {yearLabel}
                  </span>
                </div>

                <div class="relative z-10 flex justify-center pt-[1.85rem]">
                  <span
                    data-exp-dot
                    class:list={[
                      'exp-dot relative block size-3 rounded-full border-2 border-canvas',
                      isCurrent ? 'exp-dot--current' : 'exp-dot--achieved',
                    ]}
                    aria-hidden="true"
                  />
                </div>

                <div
                  data-exp-card
                  class="exp-card ml-3 cursor-pointer border border-[color:var(--hairline)] bg-[color:var(--surface)]/45 p-5 transition-colors duration-200 hover:border-[color:var(--brand)]/55 hover:bg-[color:var(--surface)]/80 sm:ml-4 sm:p-7"
                >
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <div class="flex flex-wrap items-center gap-3">
                      <h3 class="display text-[1.5rem] leading-tight sm:text-[1.9rem]">{d.company}</h3>
                      {isCurrent && (
                        <span class="label inline-flex items-center gap-1.5 rounded-[2px] border border-[color:var(--signal)]/40 bg-[color:var(--signal)]/10 px-2 py-1 text-[0.5rem] text-signal">
                          <span class="exp-live-dot size-1.5 rounded-full bg-signal" aria-hidden="true"></span>
                          {isId ? 'AKTIF' : 'CURRENT'}
                        </span>
                      )}
                    </div>
                    <span class="numeral text-sm text-brand sm:hidden">{yearLabel}</span>
                  </div>

                  <p class="label mt-2">
                    {d.role} · {d.type} · {d.period}
                  </p>

                  <p class="mt-4 max-w-[46rem] text-sm leading-relaxed text-subtle">{d.summary}</p>

                  <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-[color:var(--hairline)] pt-4">
                    <div class="flex flex-wrap gap-1.5">
                      {d.stack.map((tech) => <span class="tag">{tech}</span>)}
                    </div>

                    {d.points.length > 0 && (
                      <button
                        type="button"
                        data-exp-toggle
                        aria-expanded="false"
                        aria-controls={panelId}
                        class="label inline-flex cursor-pointer items-center gap-1.5 rounded-[2px] border border-[color:var(--hairline)] px-2.5 py-1.5 text-[0.5625rem] text-ink transition-colors hover:border-brand hover:text-brand"
                      >
                        <span
                          data-exp-toggle-label
                          data-open-text={isId ? `+ SOROTAN (${d.points.length})` : `+ IMPACT (${d.points.length})`}
                          data-close-text={isId ? '− TUTUP' : '− HIDE'}
                        >
                          {isId ? `+ SOROTAN (${d.points.length})` : `+ IMPACT (${d.points.length})`}
                        </span>
                      </button>
                    )}
                  </div>

                  {d.points.length > 0 && (
                    <div id={panelId} data-exp-panel class="exp-expand-panel">
                      <div class="exp-expand-panel__inner">
                        <ul class="mt-4 space-y-2.5 border-t border-[color:var(--hairline)] pt-4">
                          {d.points.map((pt) => (
                            <li data-exp-point class="flex gap-3 text-[0.8125rem] leading-relaxed text-subtle">
                              <span class="text-brand" aria-hidden="true">-</span>
                              <span>{pt}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  )}
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>
