---
import { getCollection } from 'astro:content';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isId = locale === 'id';

const entries = (await getCollection('experiences')).sort((a, b) => a.data.order - b.data.order);
const labels = {
  exp: isId ? 'PENGALAMAN' : 'EXPERIENCE',
  title: isId ? 'Perjalanan & pengalaman.' : 'Journey & experience.',
};
---

<section id="experience" class="border-t border-[color:var(--hairline)] bg-canvas text-ink">
  <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-10 lg:px-16 lg:py-28">
    <div class="mb-16 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="label mb-8">
          <span class="text-brand">04</span> — <span data-scramble="view">{labels.exp}</span>
        </p>
        <h2 class="display text-[2.25rem] sm:text-[3.25rem]" data-reveal="press" data-split>
          {labels.title}
        </h2>
      </div>
      <p class="label">
        {isId ? `${entries.length} peran · klik detail untuk sorotan` : `${entries.length} roles · expand for highlights`}
      </p>
    </div>

    <!-- Pixel-aligned timeline: dedicated spine column so dots sit at exact 0px offset -->
    <div class="relative" data-exp-list>
      <!-- Continuous vertical spine track & scrubbed clay fill -->
      <div
        data-exp-spine
        aria-hidden="true"
        class="pointer-events-none absolute top-3 bottom-3 left-[0.75rem] w-px -translate-x-1/2 bg-[color:var(--hairline)] sm:left-[8.75rem]"
      >
        <div
          data-exp-spine-fill
          class="exp-spine-fill h-full w-[2px] -translate-x-[0.5px] bg-brand"
        ></div>
      </div>

      <ol class="space-y-8 sm:space-y-10">
        {
          entries.map((entry, i) => {
            const d = entry.data;
            const yearLabel = d.period.split('—')[0].trim().split(' ').slice(-1)[0];
            const panelId = `exp-impact-${i}`;
            return (
              <li
                data-exp-item
                class="grid grid-cols-[1.5rem_1fr] items-start sm:grid-cols-[7.5rem_2.5rem_1fr]"
              >
                <!-- Desktop Col 1: Year right-aligned cleanly left of the spine -->
                <div class="hidden pr-4 pt-5 text-right sm:block">
                  <span
                    class:list={[
                      'numeral text-[1.35rem] leading-none',
                      i === 0 ? 'text-brand' : 'text-subtle',
                    ]}
                  >
                    {yearLabel}
                  </span>
                </div>

                <!-- Col 2 (Col 1 mobile): Centered dot directly on the vertical spine -->
                <div class="relative z-10 flex justify-center pt-6">
                  <span
                    data-exp-dot
                    class:list={[
                      'exp-dot block size-3 rounded-full border-2 border-canvas',
                      i === 0 && 'is-lit',
                    ]}
                    aria-hidden="true"
                  />
                </div>

                <!-- Col 3: Clean experience card with expandable impact points -->
                <div class="ml-3 border border-[color:var(--hairline)] bg-[color:var(--surface)]/45 p-5 transition-colors duration-300 hover:border-[color:var(--brand)]/50 hover:bg-[color:var(--surface)]/80 sm:ml-4 sm:p-7">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h3 class="display text-[1.5rem] leading-tight sm:text-[1.9rem]">{d.company}</h3>
                    <span class="numeral text-sm text-brand sm:hidden">{yearLabel}</span>
                  </div>

                  <p class="label mt-2">
                    {d.role} · {d.type} · {d.period}
                  </p>

                  <p class="mt-4 max-w-[46rem] text-sm leading-relaxed text-subtle">{d.summary}</p>

                  <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-[color:var(--hairline)] pt-4">
                    <div class="flex flex-wrap gap-1.5">
                      {d.stack.map((tech) => <span class="tag">{tech}</span>)}
                    </div>

                    {d.points.length > 0 && (
                      <button
                        type="button"
                        data-exp-toggle
                        aria-expanded="false"
                        aria-controls={panelId}
                        class="label inline-flex cursor-pointer items-center gap-1.5 rounded-[2px] border border-[color:var(--hairline)] px-2.5 py-1.5 text-[0.5625rem] text-ink transition-colors hover:border-brand hover:text-brand"
                      >
                        <span
                          data-exp-toggle-label
                          data-open-text={isId ? `+ SOROTAN (${d.points.length})` : `+ IMPACT (${d.points.length})`}
                          data-close-text={isId ? '− TUTUP' : '− HIDE'}
                        >
                          {isId ? `+ SOROTAN (${d.points.length})` : `+ IMPACT (${d.points.length})`}
                        </span>
                      </button>
                    )}
                  </div>

                  {d.points.length > 0 && (
                    <div id={panelId} data-exp-panel class="exp-expand-panel">
                      <div class="exp-expand-panel__inner">
                        <ul class="mt-4 space-y-2.5 border-t border-[color:var(--hairline)] pt-4">
                          {d.points.map((pt) => (
                            <li class="flex gap-3 text-[0.8125rem] leading-relaxed text-subtle">
                              <span class="text-brand" aria-hidden="true">—</span>
                              <span>{pt}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  )}
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>
