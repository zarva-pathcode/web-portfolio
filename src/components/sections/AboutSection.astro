---
import { aboutContent, disciplines } from '../../data/site';
import { localePath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isId = locale === 'id';
const copy = aboutContent[locale];
const homeBase = localePath(locale, '/');
---

<section id="about" class="border-t border-[color:var(--hairline)] bg-canvas text-ink">
  <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-10 lg:px-16 lg:py-28">
    <p class="label mb-12">
      <span class="text-brand">02</span> — <span data-scramble="view">{isId ? 'TENTANG' : 'ABOUT'}</span>
    </p>

    <div class="grid gap-12 lg:grid-cols-[1.15fr_1fr]">
      <h2 class="display text-[2.25rem] sm:text-[3.25rem] lg:text-[4rem]" data-reveal="press" data-split>
        {copy.statement}
      </h2>

      <div data-reveal="ink">
        <p class="max-w-[34rem] text-base leading-relaxed text-subtle">{copy.body}</p>
        <dl class="mt-8 space-y-2 border-t border-[color:var(--hairline)] pt-6">
          {
            copy.meta.map(([k, v]) => (
              <div class="flex gap-6">
                <dt class="label w-28 shrink-0">{k}</dt>
                <dd class="label text-ink">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- 3 Interactive Editorial Bento Cards with live looping vector micro-diagrams -->
    <ul class="mt-16 grid grid-cols-1 gap-5 md:grid-cols-3" data-stagger>
      {
        disciplines.map((d, idx) => (
          <li>
            <a
              href={`${homeBase === '/' ? '' : homeBase}/#projects`}
              class="bento-card group flex h-full flex-col justify-between border border-[color:var(--hairline)] bg-[color:var(--surface)]/75 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[color:var(--brand)] hover:bg-[color:var(--hover)] sm:p-7"
            >
              <div>
                <div class="mb-6 flex items-center justify-between">
                  <span class="numeral text-sm text-brand">{d.index}</span>
                  <span
                    class="label text-[0.5625rem] text-subtle transition-transform duration-300 group-hover:translate-x-1 group-hover:text-brand"
                    aria-hidden="true"
                  >
                    {d.slug.toUpperCase()} →
                  </span>
                </div>

                <!-- Live looping vector micro-diagram (paused offscreen & under reduced-motion) -->
                <div
                  data-bento-diagram
                  class="bento-diagram mb-7 flex h-28 items-center justify-center overflow-hidden border border-[color:var(--hairline)] bg-canvas/70 px-4"
                  aria-hidden="true"
                >
                  {idx === 0 && (
                    <svg viewBox="0 0 220 92" class="bento-svg h-20 w-full text-ink" fill="none">
                      <!-- 01 Mobile: Flutter phone + live BLoC event/state bus -->
                      <rect x="24" y="10" width="44" height="72" rx="6" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.2" />
                      <line x1="40" y1="16" x2="52" y2="16" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.2" stroke-linecap="round" />
                      <rect class="bento-flow-a" x="31" y="25" width="30" height="16" rx="2" fill="var(--brand)" fill-opacity="0.22" stroke="var(--brand)" stroke-width="1.1" />
                      <rect class="bento-flow-b" x="31" y="46" width="30" height="8" rx="1.5" fill="currentColor" fill-opacity="0.18" />
                      <rect x="31" y="58" width="20" height="8" rx="1.5" fill="currentColor" fill-opacity="0.1" />
                      <path class="bento-bus-line" d="M74 33 H114 M74 55 H114" stroke="currentColor" stroke-opacity="0.28" stroke-dasharray="3 3" />
                      <circle class="bento-pulse-dot" cx="76" cy="33" r="3" fill="var(--brand)" />
                      <circle class="bento-pulse-dot-rev" cx="112" cy="55" r="2.4" fill="var(--signal)" />
                      <rect class="bento-flow-a" x="118" y="20" width="76" height="22" rx="2" stroke="currentColor" stroke-opacity="0.32" stroke-width="1.1" />
                      <rect x="126" y="28" width="34" height="5" rx="1" fill="var(--brand)" fill-opacity="0.72" />
                      <rect class="bento-flow-b" x="118" y="48" width="76" height="22" rx="2" stroke="currentColor" stroke-opacity="0.24" stroke-width="1.1" />
                      <rect x="126" y="56" width="46" height="5" rx="1" fill="currentColor" fill-opacity="0.26" />
                    </svg>
                  )}
                  {idx === 1 && (
                    <svg viewBox="0 0 220 92" class="bento-svg h-20 w-full text-ink" fill="none">
                      <!-- 02 Systems: Live modular grid & pulsing design token -->
                      <line x1="20" y1="20" x2="200" y2="20" stroke="currentColor" stroke-opacity="0.12" />
                      <line x1="20" y1="46" x2="200" y2="46" stroke="currentColor" stroke-opacity="0.12" />
                      <line x1="20" y1="72" x2="200" y2="72" stroke="currentColor" stroke-opacity="0.12" />
                      <rect class="bento-grid-a" x="28" y="16" width="52" height="60" rx="2" stroke="var(--brand)" stroke-width="1.2" fill="var(--brand)" fill-opacity="0.13" />
                      <rect class="bento-grid-b" x="90" y="16" width="44" height="26" rx="2" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.1" />
                      <rect class="bento-grid-a" x="90" y="50" width="44" height="26" rx="2" stroke="currentColor" stroke-opacity="0.24" stroke-width="1.1" />
                      <circle class="bento-ring" cx="164" cy="29" r="11" stroke="var(--brand)" stroke-width="1.2" stroke-dasharray="18 6" />
                      <circle class="bento-token-core" cx="164" cy="29" r="4" fill="var(--brand)" />
                      <rect class="bento-grid-b" x="146" y="50" width="46" height="26" rx="2" fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-opacity="0.3" stroke-width="1.1" />
                    </svg>
                  )}
                  {idx === 2 && (
                    <svg viewBox="0 0 220 92" class="bento-svg h-20 w-full text-ink" fill="none">
                      <!-- 03 Engineering: Browser live component render & code module -->
                      <rect x="26" y="14" width="116" height="64" rx="3" stroke="currentColor" stroke-opacity="0.32" stroke-width="1.2" />
                      <line x1="26" y1="26" x2="142" y2="26" stroke="currentColor" stroke-opacity="0.2" />
                      <circle cx="34" cy="20" r="1.8" fill="var(--brand)" />
                      <circle cx="41" cy="20" r="1.8" fill="currentColor" fill-opacity="0.3" />
                      <rect class="bento-render-a" x="36" y="34" width="44" height="34" rx="1.5" fill="var(--brand)" fill-opacity="0.18" stroke="var(--brand)" stroke-width="1" />
                      <rect class="bento-render-b" x="86" y="34" width="46" height="14" rx="1.5" fill="currentColor" fill-opacity="0.18" />
                      <rect class="bento-render-c" x="86" y="54" width="32" height="14" rx="1.5" fill="currentColor" fill-opacity="0.12" />
                      <rect class="bento-code-box" x="156" y="24" width="38" height="44" rx="2" stroke="var(--brand)" stroke-width="1.1" fill="var(--canvas)" />
                      <path class="bento-code-glyph" d="M167 42 L162 46 L167 50 M183 42 L188 46 L183 50 M177 40 L173 52" stroke="var(--brand)" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                  )}
                </div>

                <h3 class="display text-[1.75rem] leading-tight sm:text-[2rem]">{d.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-subtle">
                  {isId ? d.bodyId : d.body}
                </p>
              </div>

              <div class="mt-7 flex flex-wrap gap-1.5 border-t border-[color:var(--hairline)] pt-4">
                {d.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
