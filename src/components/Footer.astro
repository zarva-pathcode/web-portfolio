---

<footer
  id="contact"
  class="no-print canvas border-t border-white/10 pt-24 pb-12"
>
  <div class="reveal flex flex-col justify-between gap-10 md:flex-row md:items-end">
    <ul class="flex flex-wrap gap-x-6 gap-y-2.5">
      {
        social.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="me noopener noreferrer"
              class="group inline-flex items-center gap-2 text-sm text-subtle transition-colors hover:text-ink"
            >
              <svg viewBox="0 0 24 24" class="size-3.5 fill-current" aria-hidden="true">
                <path d={icons[s.label]} />
              </svg>
              <span>{s.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="md:text-right">
      <p class="text-sm text-subtle">{tr['footer.tagline']}</p>
      <a
        href={`mailto:${site.email}`}
        class="mt-1 inline-block text-lg font-semibold tracking-tight text-ink transition-opacity hover:opacity-80 sm:text-xl"
      >
        {site.email}
      </a>
    </div>
  </div>

  <p
    class="mt-16 select-none text-[16vw] leading-[0.82] font-semibold tracking-tighter text-ink sm:text-[13vw] lg:text-[10.5rem]"
  >
    {site.brand}.
  </p>

  <div
    class="mt-10 flex flex-col gap-3 border-t border-white/8 pt-6 text-xs text-subtle sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {site.brand}. {tr['footer.rights']}</p>
    <div class="flex gap-5">
      <a href={localePath(locale, '/blog')} class="transition-colors hover:text-ink">
        {tr['blog.index']}
      </a>
      <a href={localePath(locale, '/cv')} class="transition-colors hover:text-ink">
        {tr['cv.title']}
      </a>
      <span>{tr['footer.builtWith']} Astro</span>
    </div>
  </div>
</footer>
