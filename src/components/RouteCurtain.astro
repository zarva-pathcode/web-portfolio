---
interface Props {
  brand?: string;
}
const { brand = 'ZARVAISM' } = Astro.props;
---

<div
  id="route-curtain"
  data-route-curtain
  transition:persist="route-curtain"
  aria-hidden="true"
  class="route-curtain pointer-events-none fixed inset-0 z-[90] overflow-hidden"
>
  <!-- Secondary depth blades (trail slightly behind the primary split doors for architectural depth) -->
  <div
    data-curtain-blade-left
    class="curtain-leaf absolute inset-y-0 left-0 w-[50.4%] bg-[color:var(--brand)]/25"
  ></div>
  <div
    data-curtain-blade-right
    class="curtain-leaf absolute inset-y-0 right-0 w-[50.4%] bg-[color:var(--brand)]/25"
  ></div>

  <!-- Primary Dual-Door Split Curtains (Left & Right gallery doors) -->
  <div
    data-curtain-left
    class="curtain-leaf absolute inset-y-0 left-0 w-[50.25%] border-r border-[color:var(--brand)]/40 bg-[color:var(--surface)]"
  >
    <div class="pointer-events-none absolute inset-y-0 right-0 w-[2px] bg-[color:var(--brand)]/55"></div>
  </div>
  <div
    data-curtain-right
    class="curtain-leaf absolute inset-y-0 right-0 w-[50.25%] border-l border-[color:var(--brand)]/40 bg-[color:var(--surface)]"
  >
    <div class="pointer-events-none absolute inset-y-0 left-0 w-[2px] bg-[color:var(--brand)]/55"></div>
  </div>

  <!-- Center Architectural Seam -->
  <div
    data-curtain-seam
    class="pointer-events-none absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-[color:var(--brand)]/50"
  ></div>

  <!-- Masked Editorial Typography Lockup (clean surface frame so center seam never slices through letters) -->
  <div
    data-curtain-center
    class="relative z-10 flex h-full w-full flex-col items-center justify-center px-6 text-center text-ink"
  >
    <div class="flex flex-col items-center bg-[color:var(--surface)] px-8 py-6">
      <div class="overflow-hidden">
        <p
          data-curtain-kicker
          class="label inline-flex items-center gap-2.5 text-[0.625rem] tracking-[0.24em] text-brand"
        >
          <span class="size-1.5 rounded-full bg-brand" aria-hidden="true"></span>
          <span data-curtain-meta>{brand}</span>
        </p>
      </div>

      <div class="mt-3 overflow-hidden py-1">
        <p
          data-curtain-route
          class="display text-[2.75rem] leading-[0.98] tracking-[-0.03em] text-ink sm:text-[4.5rem] lg:text-[5.5rem]"
        >
          {brand}
        </p>
      </div>

      <div class="mt-7 h-px w-36 overflow-hidden bg-[color:var(--hairline)] sm:w-52">
        <div data-curtain-line class="h-full w-full origin-center bg-brand"></div>
      </div>
    </div>
  </div>
</div>
