---
import Page from '../layouts/Page.astro';
import { renderMarkdownSafe } from '../lib/cms/markdown';
import type { ProjectRecord } from '../lib/cms/repository';
import { localePath, type Locale } from '../i18n';

interface Props {
  project: ProjectRecord;
  locale: Locale;
  next?: { slug: string; title: string };
  index?: number;
  total?: number;
}

const { project: d, locale, next, index = 1, total = 3 } = Astro.props;
const isId = locale === 'id';

const spec = [
  { k: isId ? 'Perangkat' : 'Device', v: d.platform },
  { k: 'Stack', v: d.stack.slice(0, 4).join(' · ') },
  { k: isId ? 'Tahun' : 'Year', v: String(d.year), numeral: true },
  { k: 'Role', v: d.role },
];

const blocks = [
  { n: '01', k: isId ? 'MASALAH' : 'PROBLEM', v: d.problem },
  { n: '02', k: isId ? 'PENDEKATAN' : 'APPROACH', v: d.approach },
  { n: '03', k: isId ? 'HASIL' : 'RESULT', v: d.result },
];

const bodyHtml = d.bodyMarkdown ? renderMarkdownSafe(d.bodyMarkdown) : '';
---

<Page title={`${d.title} | ${d.role}`} description={d.summary}>
  <article data-cms-section="projects" data-cms-item-id={d.id} class="bg-canvas text-ink">
    <div class="mx-auto max-w-[1440px] px-5 sm:px-10 lg:px-16">
      <div class="flex items-center justify-between border-b border-[color:var(--hairline)] py-4">
        <a
          href={localePath(locale, '/#projects')}
          data-scramble="hover"
          class="label transition-colors hover:text-ink"
        >
          ← {isId ? 'SEMUA KARYA' : 'ALL WORK'}
        </a>
        <span class="label text-brand">{String(index).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
      </div>

      <header class="pt-14 pb-12">
        <p class="label mb-6">
          <span class="text-brand" data-scramble="view">{isId ? 'STUDI KASUS' : 'CASE STUDY'}</span> · {d.category}
        </p>
        <h1 class="display text-[3.25rem] leading-[0.95] sm:text-[6rem] lg:text-[8rem]" data-split>
          {d.title}
        </h1>
        <p class="label mt-8">
          {d.year} · {d.role} · {d.platform}
        </p>
      </header>

      <figure class="border border-[color:var(--hairline)] bg-[color:var(--surface)] p-4 sm:p-8" data-reveal="screen">
        <img
          src={d.coverUrl}
          alt={d.coverAlt}
          class="mx-auto h-auto w-full object-contain"
          loading="eager"
          decoding="async"
        />
      </figure>

      <dl
        class="mt-10 grid grid-cols-2 gap-x-8 gap-y-6 border-b border-[color:var(--hairline)] pb-10 sm:grid-cols-4"
        data-stagger
      >
        {
          spec.map((s) => (
            <div>
              <dt class="label mb-2">{s.k}</dt>
              {s.numeral ? (
                <dd class="numeral text-lg text-brand">{s.v}</dd>
              ) : (
                <dd class="text-[0.9375rem] text-ink">{s.v}</dd>
              )}
            </div>
          ))
        }
      </dl>

      <p class="display max-w-[54rem] py-14 text-[1.75rem] leading-[1.25] sm:text-[2.5rem]" data-reveal="ink">
        {d.summary}
      </p>

      <div class="grid gap-12 border-t border-[color:var(--hairline)] py-14 lg:grid-cols-2" data-stagger>
        <div class="space-y-10">
          {
            blocks.slice(0, 2).map((b) => (
              <section>
                <p class="label mb-4 text-brand">{b.n} · {b.k}</p>
                <p class="max-w-[34rem] text-[0.9375rem] leading-[1.7] text-subtle">{b.v}</p>
              </section>
            ))
          }
        </div>
        <div class="space-y-10">
          <section>
            <p class="label mb-4 text-brand">{blocks[2].n} · {blocks[2].k}</p>
            <p class="max-w-[34rem] text-[0.9375rem] leading-[1.7] text-subtle">{blocks[2].v}</p>
          </section>
        </div>
      </div>

      {
        bodyHtml && (
          <div class="border-t border-[color:var(--hairline)] py-12">
            <div class="prose max-w-3xl" set:html={bodyHtml} />
          </div>
        )
      }

      {
        d.metrics.length > 0 && (
          <div class="border-t border-[color:var(--hairline)] py-14">
            <p class="label mb-8">{isId ? 'Hasil Terukur' : 'Key Numbers'}</p>
            <dl class="flex flex-wrap gap-x-16 gap-y-8" data-stagger>
              {d.metrics.map((m) => (
                <div>
                  <dd class="display text-[2.75rem] leading-none">{m.value}</dd>
                  <dt class="label mt-3">{m.label}</dt>
                </div>
              ))}
            </dl>
          </div>
        )
      }

      {
        d.gallery.length > 0 && (
          <div class="border-t border-[color:var(--hairline)] py-14">
            <p class="label mb-8">{isId ? 'Galeri' : 'Gallery'}</p>
            <div class="grid gap-4 sm:grid-cols-2" data-stagger>
              {d.gallery.map((imgUrl) => (
                <div class="border border-[color:var(--hairline)] bg-[color:var(--surface)] p-3">
                  <img
                    src={imgUrl}
                    alt={`${d.title} (${isId ? 'tangkapan layar' : 'screenshot'})`}
                    class="h-auto w-full object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ))}
            </div>
          </div>
        )
      }

      <div class="grid gap-12 border-t border-[color:var(--hairline)] py-14 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="label mb-6">{isId ? 'Sorotan' : 'Highlights'}</p>
          <ul class="space-y-3" data-stagger>
            {
              d.highlights.map((h) => (
                <li class="flex gap-4 text-[0.9375rem] leading-relaxed text-ink">
                  <span class="text-brand">-</span>
                  <span>{h}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="label mb-6">{isId ? 'Tautan' : 'Links'}</p>
          <ul class="space-y-3">
            {
              d.links.length === 0 && (
                <li class="label">{isId ? 'TAUTAN TIDAK TERSEDIA' : 'NO PUBLIC LINKS'}</li>
              )
            }
            {d.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  data-scramble="hover"
                  class="label text-brand-ink transition-colors hover:text-brand"
                  target={l.href.startsWith('http') ? '_blank' : undefined}
                  rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {l.label} ↗
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {
        next && (
          <a
            href={localePath(locale, `/projects/${next.slug}`)}
            data-cursor-label={isId ? 'BERIKUTNYA →' : 'NEXT CASE →'}
            class="group flex items-end justify-between border-t border-[color:var(--hairline)] py-12 transition-colors hover:bg-[color:var(--hover)] sm:px-3"
          >
            <span>
              <span class="label mb-3 block">{isId ? 'PROYEK BERIKUTNYA' : 'NEXT PROJECT'}</span>
              <span class="display text-[2rem] sm:text-[3rem]">{next.title}</span>
            </span>
            <span class="display text-[2rem] text-brand transition-transform group-hover:translate-x-1">→</span>
          </a>
        )
      }
    </div>
  </article>
</Page>
