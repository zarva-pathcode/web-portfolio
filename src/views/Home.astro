---
import Page from '../layouts/Page.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Disciplines from '../components/Disciplines.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import OtherProjects from '../components/OtherProjects.astro';
import Contact from '../components/Contact.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Page>
  <Hero locale={locale} />
  <About locale={locale} />
  <Disciplines locale={locale} />
  <ExperienceTimeline locale={locale} />
  <FeaturedProjects locale={locale} />
  <OtherProjects locale={locale} />
  <Contact locale={locale} />
</Page>
