---
import { getAllSections, listExperiences, listProjects } from '../lib/cms/repository';
import Page from '../layouts/Page.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import HowIWork from '../components/sections/HowIWork.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import WorkSection from '../components/sections/WorkSection.astro';
import OtherProjectsSection from '../components/sections/OtherProjectsSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const [sections, experienceList, featuredProjects] = await Promise.all([
  getAllSections(),
  listExperiences(),
  listProjects({ featuredOnly: true, includeDrafts: false }),
]);
---

<Page settings={sections.settings} hero={sections.hero}>
  <Hero locale={locale} hero={sections.hero} settings={sections.settings} />
  <AboutSection locale={locale} about={sections.about} />
  <HowIWork locale={locale} how={sections.how} />
  <ExperienceSection locale={locale} experiences={experienceList} />
  <WorkSection locale={locale} projects={featuredProjects} />
  <OtherProjectsSection locale={locale} otherProjects={sections.other_projects} />
  <FaqSection locale={locale} faq={sections.faq} />
</Page>
