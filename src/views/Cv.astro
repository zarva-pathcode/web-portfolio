---
import Page from '../layouts/Page.astro';
import { getCollection } from 'astro:content';
import { site, social, cvData } from '../data/site';
import { type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isId = locale === 'id';

const roles = (await getCollection('experiences')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const contactLine = `${site.email} · ${site.location}`;
---

<Page title={`CV — ${site.name}`} description={site.description}>
  <article class="bg-canvas text-ink">
    <div class="mx-auto max-w-[1440px] px-5 py-14 sm:px-10 lg:px-16">
      <!-- header -->
      <div class="flex flex-wrap items-start justify-between gap-6 border-b border-[color:var(--hairline)] pb-10">
        <div>
          <p class="label mb-5">
            <span class="text-brand" data-scramble="view">{isId ? 'DAFTAR RIWAYAT HIDUP' : 'CURRICULUM VITAE'}</span> — {cvData.year}
          </p>
          <h1 class="display text-[2.5rem] leading-[1.02] sm:text-[4rem]" data-split>{site.name}</h1>
          <p class="label mt-5">{site.role} — Flutter &amp; React</p>
          <p class="label mt-2 normal-case tracking-normal">{contactLine}</p>
        </div>

        <a
          href={cvData.pdfHref}
          download
          data-magnetic
          class="btn btn--ghost btn-roll h-10 px-5 text-[0.5625rem] no-print"
        >
          <span class="btn-roll__track">
            <span class="btn-roll__text">{isId ? 'UNDUH PDF' : 'DOWNLOAD PDF'}</span>
            <span class="btn-roll__text btn-roll__text--clone" aria-hidden="true">
              {isId ? 'UNDUH PDF' : 'DOWNLOAD PDF'}
            </span>
          </span>
        </a>
      </div>

      <div class="mt-12 grid gap-14 lg:grid-cols-[1.45fr_1fr]">
        <!-- main column -->
        <div>
          <section>
            <h2 class="label mb-6 text-brand">{isId ? 'PENGALAMAN' : 'EXPERIENCE'}</h2>
            <ol class="space-y-9">
              {
                roles.map((r) => (
                  <li>
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <h3 class="text-[1.0625rem] text-ink">{r.data.company}</h3>
                      <span class="label whitespace-nowrap">{r.data.period}</span>
                    </div>
                    <p class="label mt-1">
                      {r.data.role} · {r.data.type} · {r.data.location}
                    </p>
                    <ul class="mt-3 space-y-1.5">
                      {r.data.points.map((p) => (
                        <li class="flex gap-3 text-[0.8125rem] leading-relaxed text-subtle">
                          <span class="text-brand">—</span>
                          <span>{p}</span>
                        </li>
                      ))}
                    </ul>
                  </li>
                ))
              }
            </ol>
          </section>

          <section class="mt-12 border-t border-[color:var(--hairline)] pt-10">
            <h2 class="label mb-6 text-brand">{isId ? 'PROYEK PILIHAN' : 'SELECTED PROJECTS'}</h2>
            <ul class="space-y-4">
              {
                projects.map((p) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-2">
                    <span class="text-[0.875rem] text-ink">
                      {p.data.title} — {p.data.category}
                    </span>
                    <span class="label">{p.data.year}</span>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>

        <!-- side column -->
        <div class="space-y-10">
          <section>
            <h2 class="label mb-6 text-brand">SKILLS</h2>
            <dl class="space-y-3">
              {
                cvData.skillGroups.map((g) => (
                  <div>
                    <dt class="label text-ink">{g.label}</dt>
                    <dd class="mt-1 text-[0.8125rem] leading-relaxed text-subtle">{g.items}</dd>
                  </div>
                ))
              }
            </dl>
          </section>

          <section class="border-t border-[color:var(--hairline)] pt-8">
            <h2 class="label mb-6 text-brand">{isId ? 'PENDIDIKAN' : 'EDUCATION'}</h2>
            <ul class="space-y-4">
              {
                cvData.education.map((e) => (
                  <li>
                    <p class="text-[0.875rem] text-ink">{e.school}</p>
                    <p class="text-[0.8125rem] text-subtle">{e.degree[locale]}</p>
                    <p class="label mt-1">{e.period}</p>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="border-t border-[color:var(--hairline)] pt-8">
            <h2 class="label mb-6 text-brand">{isId ? 'PENGHARGAAN' : 'RECOGNITION'}</h2>
            <ul class="space-y-4">
              {
                cvData.certifications.map((c) => (
                  <li>
                    <p class="text-[0.875rem] text-ink">{c.title}</p>
                    <p class="text-[0.8125rem] text-subtle">{c.issuer}</p>
                    <p class="label mt-1">{c.period}</p>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="border-t border-[color:var(--hairline)] pt-8">
            <h2 class="label mb-6 text-brand">{isId ? 'ORGANISASI' : 'ORGANISATION'}</h2>
            <ul class="space-y-3">
              {
                cvData.organisation.map((o) => (
                  <li>
                    <p class="text-[0.8125rem] text-subtle">{o.role[locale]}</p>
                    <p class="label mt-1">{o.period}</p>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="border-t border-[color:var(--hairline)] pt-8">
            <h2 class="label mb-6 text-brand">LINKS</h2>
            <ul class="space-y-2">
              {
                social.map((s) => (
                  <li>
                    <a
                      href={s.href}
                      target="_blank"
                      rel="me noopener noreferrer"
                      class="label normal-case tracking-normal text-ink hover:text-brand-ink"
                    >
                      {s.handle}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>
      </div>

      <p class="label mt-16 border-t border-[color:var(--hairline)] pt-6">
        {isId
          ? 'HALAMAN INI SIAP CETAK — CMD/CTRL + P MENGHASILKAN PDF YANG SAMA'
          : 'THIS PAGE IS PRINT-READY — CMD/CTRL + P PRODUCES THE SAME PDF'}
      </p>
    </div>
  </article>
</Page>

<style>
  @media print {
    :global(header),
    :global(footer),
    :global(aside),
    .no-print {
      display: none !important;
    }
    :global(:root) {
      --canvas: #ffffff;
      --ink: #111111;
      --subtle: #333333;
      --brand: #8a3a1e;
      --hairline: rgba(0, 0, 0, 0.25);
    }
    :global(body) {
      background: #fff !important;
      color: #111 !important;
    }
    article {
      padding: 0 !important;
    }
    section {
      break-inside: avoid;
    }
  }
</style>
