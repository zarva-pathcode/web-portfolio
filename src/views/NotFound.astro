---
import Page from '../layouts/Page.astro';
import { localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isId = locale === 'id';

const copy = isId
  ? {
      label: 'HALAMAN TIDAK DITEMUKAN',
      title: 'Halaman ini tidak ada.',
      body: 'Mungkin sudah dipindah, atau tautannya salah ketik. Yang penting bukan 404-nya, tapi ke mana kamu pergi setelah ini.',
      cta: 'Kembali ke beranda',
      work: 'Lihat karya',
    }
  : {
      label: 'PAGE NOT FOUND',
      title: 'This page does not exist.',
      body: 'It may have moved, or the link was mistyped. What matters is not the 404 — it is where you go next.',
      cta: 'Back to home',
      work: 'See the work',
    };
---

<Page title={`404 — ${copy.title}`} description={copy.body}>
  <div class="bg-canvas text-ink">
    <div class="mx-auto flex min-h-[78svh] max-w-[1440px] flex-col justify-center px-5 py-24 sm:px-10 lg:px-16">
      <p class="label mb-10"><span class="text-brand">404</span> — {copy.label}</p>

      <h1 class="display max-w-[46rem] text-[2.75rem] leading-[0.98] sm:text-[4.5rem]">
        {copy.title}
      </h1>

      <p class="mt-8 max-w-[34rem] text-base leading-relaxed text-subtle">{copy.body}</p>

      <div class="mt-12 flex flex-wrap gap-3">
        <a href={localePath(locale, '/')} class="btn btn--solid">{copy.cta}</a>
        <a href={localePath(locale, '/#projects')} class="btn btn--ghost">{copy.work}</a>
      </div>

      <p class="numeral mt-20 text-[7rem] leading-none text-brand/25 sm:text-[11rem]" aria-hidden="true">
        404
      </p>
    </div>
  </div>
</Page>
