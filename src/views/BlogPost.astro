---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import { t, localePath, type Locale } from '../i18n';

interface Props {
  post: CollectionEntry<'posts'>;
  locale: Locale;
}
const { post, locale } = Astro.props;
const tr = t(locale);
const { Content } = await render(post);

const dateLabel = new Intl.DateTimeFormat(locale === 'id' ? 'id-ID' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(post.data.pubDate);
---

<Page title={post.data.title} description={post.data.description} article>
  <article class="canvas py-20 md:py-28">
    <a
      href={localePath(locale, '/blog')}
      class="group inline-flex items-center gap-2 text-sm text-subtle transition-colors hover:text-ink"
    >
      <svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M11 18l-6-6 6-6" />
      </svg>
      {tr['blog.back']}
    </a>

    <header class="mt-12 max-w-3xl">
      <p class="flex flex-wrap items-center gap-3 font-mono text-xs text-subtle">
        <time datetime={post.data.pubDate.toISOString()}>{dateLabel}</time>
        {
          post.data.tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span>{post.data.tags.join(' · ')}</span>
            </>
          )
        }
      </p>
      <h1 class="mt-5 text-4xl font-semibold tracking-tighter text-ink sm:text-5xl md:text-6xl">
        {post.data.title}
      </h1>
      <p class="mt-6 text-base leading-relaxed text-subtle md:text-lg">{post.data.description}</p>
    </header>

    <div class="prose prose-invert reveal mt-14 max-w-3xl">
      <Content />
    </div>

    <div class="mt-16 border-t border-white/10 pt-8">
      <a
        href={localePath(locale, '/blog')}
        class="group inline-flex items-center gap-2 text-sm font-medium text-ink"
      >
        {tr['blog.back']}
        <svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
      </a>
    </div>
  </article>
</Page>
