---
import ProjectDetail from '../../views/ProjectDetail.astro';
import NotFound from '../../views/NotFound.astro';
import { listProjects } from '../../lib/cms/repository';

const slug = Astro.params.slug || '';
const projects = await listProjects({ includeDrafts: Astro.locals.isAdmin });
const index = projects.findIndex((p) => p.slug === slug);
const project = index >= 0 ? projects[index] : null;
const next =
  project && projects.length > 1
    ? {
        slug: projects[(index + 1) % projects.length].slug,
        title: projects[(index + 1) % projects.length].title,
      }
    : undefined;

if (!project) {
  Astro.response.status = 404;
}
---

{
  project ? (
    <ProjectDetail
      project={project}
      next={next}
      index={index + 1}
      total={projects.length}
      locale="en"
    />
  ) : (
    <NotFound locale="en" />
  )
}
