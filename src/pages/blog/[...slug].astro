---
import BlogPost from '../../views/BlogPost.astro';
import NotFound from '../../views/NotFound.astro';
import { getPostBySlug } from '../../lib/cms/repository';

const slug = Astro.params.slug || '';
const post = await getPostBySlug(slug, {
  lang: 'en',
  includeDrafts: Astro.locals.isAdmin,
});

if (!post) {
  Astro.response.status = 404;
}
---

{post ? <BlogPost post={post} locale="en" /> : <NotFound locale="en" />}
