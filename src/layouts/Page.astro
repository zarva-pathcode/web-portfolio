---
import { ClientRouter } from 'astro:transitions';
import Base from './Base.astro';
import FloatingNav from '../components/FloatingNav.astro';
import Footer from '../components/Footer.astro';
import TransitionSquare from '../components/TransitionSquare.astro';
import Telemetry from '../components/Telemetry.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}
---

<Base {...Astro.props}>
  <ClientRouter />
  <TransitionSquare />
  <Telemetry />
  <FloatingNav />
  <main id="main">
    <slot />
  </main>
  <Footer />
</Base>
