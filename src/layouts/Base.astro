---
import '../styles/global.css';
import { site, social } from '../data/site';
import { t, localeFromPath, pathWithoutLocale, localePath, type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  alternates?: Partial<Record<Locale, string>>;
}

const pathname = Astro.url.pathname;
const locale: Locale = localeFromPath(pathname);
const tr = t(locale);

const {
  title = tr['meta.siteTitle'],
  description = tr['meta.description'],
  image = '/og.png',
  article = false,
  alternates,
} = Astro.props;

const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(pathWithoutLocale(pathname), origin);
const ogImage = new URL(image, origin);

const alternateFor = (target: Locale) =>
  alternates ? alternates[target] : localePath(target, pathWithoutLocale(pathname));

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  url: (Astro.site ?? Astro.url.origin).toString(),
  address: { '@type': 'PostalAddress', addressLocality: 'Purwokerto', addressCountry: 'ID' },
  sameAs: social.map((s) => s.href),
  knowsAbout: ['Flutter', 'React', 'TypeScript', 'PHP', 'UI/UX Design', 'Clean Architecture'],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universitas Amikom Purwokerto' },
};
---

<!doctype html>
<html lang={locale} data-theme="paper" class="scroll-pt-24">
  <head>
    <script is:inline>
      (function () {
        function applyTheme() {
          document.documentElement.classList.add('js');
          var theme = 'paper';
          try {
            var saved = localStorage.getItem('theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            theme = saved === 'paper' || saved === 'night' ? saved : prefersDark ? 'night' : 'paper';
          } catch (e) {}
          document.documentElement.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'night' ? '#12100e' : '#f3efe6');
        }
        applyTheme();
        if (!window.__zarvaThemeSwapBound) {
          window.__zarvaThemeSwapBound = true;
          document.addEventListener('astro:after-swap', applyTheme);
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f3efe6" />
    <meta name="color-scheme" content="light dark" />

    {alternateFor('en') && <link rel="alternate" hreflang="en" href={new URL(alternateFor('en')!, origin).toString()} />}
    {alternateFor('id') && <link rel="alternate" hreflang="id" href={new URL(alternateFor('id')!, origin).toString()} />}
    {alternateFor('en') && <link rel="alternate" hreflang="x-default" href={new URL(alternateFor('en')!, origin).toString()} />}

    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  </head>
  <body class="min-h-dvh bg-canvas text-ink antialiased">
    <slot />
  </body>
</html>
