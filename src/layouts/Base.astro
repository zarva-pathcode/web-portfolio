---
import '../styles/global.css';
import { site, social } from '../data/site';
import { t, localeFromPath, pathWithoutLocale, localePath, type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const pathname = Astro.url.pathname;
const locale: Locale = localeFromPath(pathname);
const tr = t(locale);

const {
  title = tr['meta.siteTitle'],
  description = tr['meta.description'],
  image = '/og.png',
  article = false,
} = Astro.props;

const canonical = new URL(pathWithoutLocale(pathname), Astro.site ?? Astro.url.origin);
const ogImage = new URL(image, Astro.site ?? Astro.url.origin);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  url: (Astro.site ?? Astro.url.origin).toString(),
  address: { '@type': 'PostalAddress', addressLocality: 'Purwokerto', addressCountry: 'ID' },
  sameAs: social.map((s) => s.href),
  knowsAbout: ['Flutter', 'React', 'TypeScript', 'PHP', 'UI/UX Design', 'Clean Architecture'],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universitas Amikom Purwokerto' },
};
---

<!doctype html>
<html lang={locale} class="scroll-pt-24">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0d1117" />
    <meta name="color-scheme" content="dark" />

    <link rel="alternate" hreflang="en" href={new URL(pathWithoutLocale(pathname), Astro.site ?? Astro.url.origin).toString()} />
    <link rel="alternate" hreflang="id" href={new URL(localePath('id', pathWithoutLocale(pathname)), Astro.site ?? Astro.url.origin).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(pathWithoutLocale(pathname), Astro.site ?? Astro.url.origin).toString()} />

    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  </head>
  <body class="min-h-dvh bg-canvas text-body antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-canvas"
    >
      {tr['nav.skip']}
    </a>

    <slot />

    <script>
      import { initBlurUp } from '../scripts/blurup';
      initBlurUp();
      // ClientRouter replaces the DOM on navigation, so rebind afterwards.
      document.addEventListener('astro:page-load', initBlurUp);
    </script>

    <!-- Cloudflare Web Analytics: free, cookie-less, works on any host -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" is:inline></script>
  </body>
</html>
