# Database (Turso LibSQL in production; defaults to local SQLite .data/zarvaism.db when omitted)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Vercel Blob (production media uploads; defaults to local .data/uploads/ when omitted)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx

# Admin CMS Authentication
# Generate password hash via: npm run cms:hash -- "your-strong-password"
ADMIN_EMAIL=bintangfara363@gmail.com
ADMIN_PASSWORD_HASH=scrypt:salt:hash
CMS_SESSION_SECRET=replace-with-at-least-32-random-hex-chars
